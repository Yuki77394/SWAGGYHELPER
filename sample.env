# ─── Telegram credentials ──────────────────────────────────────────────────
# Get these from https://my.telegram.org/apps
API_ID=
API_HASH=
# Bot token from @BotFather
BOT_TOKEN=

# ─── MongoDB ───────────────────────────────────────────────────────────────
# Get this from https://cloud.mongodb.com
MONGO_DB_URI=

# ─── Owner / log channel / support ─────────────────────────────────────────
# Numeric user id of the bot owner
OWNER_ID=
# Numeric chat id of the log channel/group (add the bot here & promote to admin)
LOGGER_ID=
# Optional override for the start-image thumbnail (defaults to a random SWAGGYMUSIC image)
START_IMG_URL=

# Public support links (shown in Start panel & Help menu)
SUPPORT_CHANNEL=https://t.me/+sTyS-zKwUIk4YWI1
SUPPORT_CHAT=https://t.me/SpIcYxNeTwOrK

# ─── Scheduled posts (optional) ──────────────────────────────────────────────
# A one-time scheduled post that became overdue while the bot was offline (more
# than SCHEDULE_MISSED_GRACE_MINUTES late): "send" = publish it once when the
# bot is back (default), "skip" = do not publish, mark it "Missed".
# Daily schedules always skip such a missed day and continue the next day.
SCHEDULE_MISSED_POLICY=send
SCHEDULE_MISSED_GRACE_MINUTES=10

# ─── Heroku (optional — only if you deploy on Heroku and want auto-restart) ─
HEROKU_APP_NAME=
HEROKU_API_KEY=
